{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxys",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "841bb63c-3886-4dc5-a5fa-ab43e1c55573","database_name": "nova-proxy123" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "08016c7f123a4945bc26a3440f44c03b" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
